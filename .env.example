# Copy to .env for local development. Deployment environment variables take precedence.
HOST=127.0.0.1
PORT=8080

# Enable on a local or access-controlled internal server. Defaults to disabled.
API_DOCS_ENABLED=true
DATABASE_URL=postgres://tenantku:tenantku@localhost:5432/tenantku?sslmode=disable
APP_ORIGIN=http://localhost:3001

# Optional readiness endpoint for the continuous worker. Leave blank to disable.
WORKER_HEALTH_ADDR=

# Set to 1 to enable quotes and one active hold per account per event.
# Requires an effective hold policy and booking_hold=true grants.
BOOKING_MAX_ACTIVE_HOLDS=
# Optional Go duration. Defaults to 30m and cannot extend a hold past the event slot.
BOOKING_HOLD_DURATION=

# Generate each secret independently, for example with openssl rand -hex 32.
JWT_SIGNING_KEY=
REFRESH_TOKEN_PEPPER=

# Email delivery is disabled when SMTP_HOST is empty.
# Local catcher (Mailpit): SMTP_HOST=localhost SMTP_PORT=1025 with no user/password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Must be a sender or domain verified at the SMTP provider.
MAIL_FROM="TenantKu <no-reply@example.com>"

# Midtrans payments (E08). Sandbox keys start with "Mid-server-" / "Mid-client-".
# Payments require MIDTRANS_ENV=sandbox and a sandbox SERVER_KEY. Never commit keys.
MIDTRANS_SERVER_KEY=
EVENT_REFUND_SANDBOX_ENABLED=false
MIDTRANS_ENV=sandbox
# Only for `go run . payments check`, which reads the channels Midtrans really offers.
MIDTRANS_CLIENT_KEY=

# Set true to require an active paid plan (event_plans) before an event can be published.
# Off by default so existing events keep working. The seeded "standard" plan costs Rp0; set its price first.
EVENT_PLAN_REQUIRED=

# Login requires a verified email by default. Set false only for local QA with unverified accounts.
AUTH_REQUIRE_VERIFIED_EMAIL=

# File unggahan (foto produk, banner acara). Gunakan direktori di volume persisten yang dibackup,
# bukan folder build. Bawaan data/uploads relatif terhadap direktori kerja API.
UPLOAD_DIR=

# Sandbox only: shows a "Simulasikan pembayaran berhasil" button because Midtrans sandbox cannot really be paid.
# The payer settles their own open attempt; booking and ledger are updated like a real settlement. Leave empty elsewhere.
PAYMENT_SIMULATION=
