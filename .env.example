# Copy to .env for local development. Deployment environment variables take precedence.
HOST=127.0.0.1
PORT=8080

# Enable on a local or access-controlled internal server. Defaults to disabled.
API_DOCS_ENABLED=true
DATABASE_URL=postgres://tenantku:tenantku@localhost:5432/tenantku?sslmode=disable
APP_ORIGIN=http://localhost:3001

# Generate each secret independently, for example with openssl rand -hex 32.
JWT_SIGNING_KEY=
REFRESH_TOKEN_PEPPER=
